<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:jee="http://www.springframework.org/schema/jee"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans-2.0.xsd
                           http://www.springframework.org/schema/jee
                           http://www.springframework.org/schema/jee/spring-jee-2.0.xsd">

	<!-- Configurer that replaces ${...} placeholders with values from a properties file -->
	<bean id="brevserver.propertyConfigurer" class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
		<!-- <property name="location" value="brevserver-remote.properties" /> -->
		<property name="locations">
			<list>
				<value>brevserver-remote.properties</value>
				<value>brev.properties</value>
				<value>log4j.properties</value>
			</list>
		</property>
		<property name="ignoreUnresolvablePlaceholders" value="true" />
	</bean>

	<jee:jndi-lookup id="brevserver.connectionFactory" jndi-name="${brevserver.connectionFactory.jndi}" />
<!-- 	<jee:jndi-lookup id="brevserver.dataSource" jndi-name="${brevserver.dataSource.jndi}" /> -->

	<bean id="brevserver.jmsTemplate" class="org.springframework.jms.core.JmsTemplate">
		<property name="connectionFactory" ref="brevserver.connectionFactory" />
	</bean>
	
	<bean id="brevserver.messageHandler" class="no.nav.brevserver.server.comptest.util.MessageHandler">
		<constructor-arg index="0" ref="brevserver.jmsTemplate" />
	</bean>

	<bean id="brevserver.dataSource" class="org.springframework.jdbc.datasource.SimpleDriverDataSource">
		<property name="driverClass" value="${brevserver.dataSource.driverClass}" />
		<property name="url" value="${brevserver.dataSource.url}" />
		<property name="username" value="${brevserver.dataSource.username}" />
		<property name="password" value="${brevserver.dataSource.password}" />
	</bean>

	<bean id="brevserver.jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
		<property name="dataSource" ref="brevserver.dataSource" />
	</bean>

