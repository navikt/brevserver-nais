<configuration xmlns="urn:activemq" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			   xsi:schemaLocation="urn:activemq /schema/artemis-configuration.xsd">
	<core xmlns="urn:activemq:core">
		<acceptors>
			<acceptor name="invm">vm://0</acceptor>
		</acceptors>
		<security-enabled>false</security-enabled>
		<persistence-enabled>false</persistence-enabled>
		<address-settings>
			<address-setting match="onlinebrev">
				<dead-letter-address>DLQ</dead-letter-address>
				<max-delivery-attempts>1</max-delivery-attempts>
			</address-setting>
			<address-setting match="dialogue">
				<dead-letter-address>DLQ</dead-letter-address>
				<max-delivery-attempts>1</max-delivery-attempts>
			</address-setting>
			<address-setting match="reply">
				<dead-letter-address>DLQ</dead-letter-address>
				<max-delivery-attempts>1</max-delivery-attempts>
			</address-setting>

		</address-settings>

		<addresses>
			<address name="onlinebrev">
				<anycast>
					<queue name="onlinebrev"/>
				</anycast>
			</address>
			<address name="onlinebrevPe">
				<anycast>
					<queue name="onlinebrevPe"/>
				</anycast>
			</address>
			<address name="dialogueOnline">
				<anycast>
					<queue name="dialogueOnline"/>
				</anycast>
			</address>
			<address name="dialogueOnlinePe">
				<anycast>
					<queue name="dialogueOnlinePe"/>
				</anycast>
			</address>
			<address name="brevReplyPe">
				<anycast>
					<queue name="brevReplyPe"/>
				</anycast>
			</address>
			<address name="SvarKo">
				<anycast>
					<queue name="SvarKo"/>
				</anycast>
			</address>

			<address name="DLQ">
				<anycast>
					<queue name="DLQ"/>
				</anycast>
			</address>
		</addresses>
	</core>
</configuration>