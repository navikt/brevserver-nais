<configuration xmlns="urn:activemq" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			   xsi:schemaLocation="urn:activemq /schema/artemis-configuration.xsd">
	<core xmlns="urn:activemq:core">
		<acceptors>
			<acceptor name="invm">vm://0</acceptor>
		</acceptors>
		<security-enabled>false</security-enabled>
		<persistence-enabled>false</persistence-enabled>
		<address-settings>
			<address-setting match="mottakArkiv">
				<dead-letter-address>mottakArkivBq</dead-letter-address>
				<max-delivery-attempts>1</max-delivery-attempts>
			</address-setting>
			<address-setting match="mottakArkivPeLinux">
				<dead-letter-address>mottakArkivPeLinuxBq</dead-letter-address>
				<max-delivery-attempts>1</max-delivery-attempts>
			</address-setting>
			<address-setting match="mottakOnlineLinux">
				<dead-letter-address>mottakOnlineLinuxBq</dead-letter-address>
				<max-delivery-attempts>1</max-delivery-attempts>
			</address-setting>
			<address-setting match="mottakOnlinePeLinux">
				<dead-letter-address>mottakOnlinePeLinuxBq</dead-letter-address>
				<max-delivery-attempts>1</max-delivery-attempts>
			</address-setting>
		</address-settings>

		<addresses>
			<address name="mottakArkiv">
				<anycast>
					<queue name="mottakArkiv"/>
				</anycast>
			</address>
			<address name="mottakArkivBq">
				<anycast>
					<queue name="mottakArkivBq"/>
				</anycast>
			</address>
			<address name="mottakArkivPeLinux">
				<anycast>
					<queue name="mottakArkivPeLinux"/>
				</anycast>
			</address>
			<address name="mottakArkivPeLinuxBq">
				<anycast>
					<queue name="mottakArkivPeLinuxBq"/>
				</anycast>
			</address>
			<address name="mottakOnlineLinux">
				<anycast>
					<queue name="mottakOnlineLinux"/>
				</anycast>
			</address>
			<address name="mottakOnlineLinuxBq">
				<anycast>
					<queue name="mottakOnlineLinuxBq"/>
				</anycast>
			</address>
			<address name="mottakOnlinePeLinux">
				<anycast>
					<queue name="mottakOnlinePeLinux"/>
				</anycast>
			</address>
			<address name="mottakOnlinePeLinuxBq">
				<anycast>
					<queue name="mottakOnlinePeLinuxBq"/>
				</anycast>
			</address>
			<address name="mottakDLQ">
				<anycast>
					<queue name="mottakDLQ"/>
				</anycast>
			</address>
			<address name="mottakSvarKo">
				<anycast>
					<queue name="mottakSvarKo"/>
				</anycast>
			</address>
		</addresses>
	</core>
</configuration>