<?xml version="1.0" encoding="utf-8"?>
<application>
  <name>brevserver</name>
  <serverType>was</serverType>
  <appConfigDir>/was_app/config/brevserver</appConfigDir>
  <virtualHost>default_host</virtualHost>
  <clusterMapping>brevserver</clusterMapping>
  <selftestPagePath>brevweb/BrevAdmin.jsp</selftestPagePath>
  <targetZone>sensitiv</targetZone>
  <artifacts>
    <artifact>
      <groupId>no.nav.brevserver</groupId>
      <artifactId>brevserver-j2ee</artifactId>
      <packaging>ear</packaging>
      <type>app</type>
      <environment>*</environment>
    </artifact>
    <artifact>
      <groupId>no.nav.brevserver</groupId>
      <artifactId>brevserver-config</artifactId>
      <packaging>jar</packaging>
      <type>appConfig</type>
      <environment>*</environment>
    </artifact>
    <artifact>
      <groupId>no.nav.brevserver</groupId>
      <artifactId>brevserver-config-env</artifactId>
	  <mapClassifierFromEnvironment>true</mapClassifierFromEnvironment>  
      <packaging>jar</packaging>
      <type>appConfig</type>
    </artifact>    
    <artifact>
      <groupId>no.nav.brevserver</groupId>
      <artifactId>brevserver-resource-config</artifactId>
      <packaging>jar</packaging>
      <type>resource</type>
      <environment>*</environment>
    </artifact>
  </artifacts>
</application>
