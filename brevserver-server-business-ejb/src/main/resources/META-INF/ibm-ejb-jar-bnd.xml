<?xml version="1.0" encoding="UTF-8"?>
<ejb-jar-bnd xmlns="http://websphere.ibm.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://websphere.ibm.com/xml/ns/javaee http://websphere.ibm.com/xml/ns/javaee/ibm-ejb-jar-bnd_1_0.xsd"
	version="1.0">
	<!-- Benyttes for å mappe MDB'er til listener ports på WAS da dette ikke lar seg gjøre med annotasjoner -->
	<message-driven name="BiBestillMdb">
		<listener-port name="BestillBrevPort" />
	</message-driven>
	<message-driven name="BiOnlineMdb">
		<listener-port name="ArkiverBrevPort" />
	</message-driven>
	<message-driven name="BiArkivMdb">
		<listener-port name="ArkiverBrevBatchPort" />
	</message-driven>
	<message-driven name="PeBestillMdb">
		<listener-port name="PEBestillBrevPort" />
	</message-driven>
	<message-driven name="PeOnlineMdb">
		<listener-port name="PEArkiverBrevPort" />
	</message-driven>
	<message-driven name="PeArkivMdb">
		<listener-port name="PEArkiverBrevBatchPort" />
	</message-driven>
</ejb-jar-bnd>
