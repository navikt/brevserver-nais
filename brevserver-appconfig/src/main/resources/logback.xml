<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds" debug="false">

	<appender name="info" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${APP_LOG_HOME}/brevserver.log</file>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>INFO</level>
		</filter>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%d{ISO8601} %p [%c] - %m%n</pattern>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${APP_LOG_HOME}/brevserver.log.%d{yyyy-MM-dd}.gz</fileNamePattern>
			<maxHistory>60</maxHistory>
		</rollingPolicy>
	</appender>

	<appender name="debug" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${APP_LOG_HOME}/brevserver_debug.log</file>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%d{ISO8601} %p [%c] - %m%n</pattern>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${APP_LOG_HOME}/brevserver_debug.log.%d{yyyy-MM-dd}.gz</fileNamePattern>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
	</appender>

	<appender name="xml" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${APP_LOG_HOME}/brevserver_xml.log</file>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%d{ISO8601} %p [%c] - %m%n</pattern>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${APP_LOG_HOME}/brevserver_xml.log.%d{yyyy-MM-dd}.gz</fileNamePattern>
			<maxHistory>60</maxHistory>
		</rollingPolicy>
	</appender>

	<appender name="perf" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${APP_LOG_HOME}/brevserver_performance.log</file>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%d{ISO8601} %p [%c] - %m%n</pattern>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${APP_LOG_HOME}/brevserver_performance.log.%d{yyyy-MM-dd}.gz</fileNamePattern>
			<maxHistory>60</maxHistory>
		</rollingPolicy>
	</appender>

	<appender name="client" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${APP_LOG_HOME}/brevserver_klientfeil.log</file>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>%d{ISO8601} %p [%c] - %m%n</pattern>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${APP_LOG_HOME}/brevserver_klientfeil.log.%d{yyyy-MM-dd}.gz</fileNamePattern>
			<maxHistory>60</maxHistory>
		</rollingPolicy>
	</appender>

	<appender name="SYSLOG" class="ch.qos.logback.classic.net.SyslogAppender">
		<syslogHost>localhost</syslogHost>
		<facility>LOCAL1</facility>
		<suffixPattern>brevserver %mdc %logger{30} %m %n%rEx</suffixPattern>
		<throwableExcluded>true</throwableExcluded>
	</appender>

	<appender name="SYSLOG-CLIENT" class="ch.qos.logback.classic.net.SyslogAppender">
		<syslogHost>localhost</syslogHost>
		<facility>LOCAL1</facility>
		<suffixPattern>client %mdc %logger{30} %m %n%rEx</suffixPattern>
		<throwableExcluded>true</throwableExcluded>
	</appender>

	<root level="WARN">
		<appender-ref ref="info"/>
		<appender-ref ref="SYSLOG"/>
	</root>

	<logger name="no.nav.brevserver" level="INFO"/>

	<logger name="no.nav.brevserver" level="${debugLoglevel:-ERROR}">
		<appender-ref ref="debug" />
	</logger>

	<logger name="no.nav.brevserver.consumer.joark.handler" level="ERROR"/>

	<logger name="no.nav.brevserver.provider.ws.handler" level="ERROR"/>

	<logger name="no.nav.brevserver.command.XmlLogger" additivity="false" level="DEBUG">
		<appender-ref ref="xml"/>
	</logger>

	<logger name="no.nav.brevserver.server.common.utility.PerformanceLogger" additivity="false" level="WARN">
		<appender-ref ref="perf"/>
	</logger>

	<logger name="no.nav.brevserver.service.loggmottak.support.DefaultLoggmottakService" additivity="false" level="WARN">
		<appender-ref ref="client"/>
		<appender-ref ref="SYSLOG-CLIENT"/>
	</logger>
</configuration>